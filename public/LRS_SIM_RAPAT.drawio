        <!-- 14. riwayat_tindak_lanjut -->
        <mxCell id="acthist_hdr" value="riwayat_tindak_lanjut" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#215865;strokeColor=#183E47;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="395" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="acthist_body" value="&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #B7791F;&quot;&gt;*id_riwayat : VARCHAR(50) [PK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_tindak_lanjut : VARCHAR(50) [FK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_pengguna : VARCHAR(50) [FK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;status_sebelumnya : ENUM&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;status_terbaru : ENUM&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;catatan_progres : TEXT&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;persentase_progres : INTEGER&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;dibuat_pada : TIMESTAMP&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94A3B8;strokeWidth=1.2;fontColor=#1E293B;fontStyle=0;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="427" width="280" height="165" as="geometry" />
        </mxCell>

        <!-- Legenda & Keterangan LRS -->
        <mxCell id="leg_hdr" value="LEGENDA NOTASI &amp; ATURAN LRS (3NF)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.3;fontColor=#1E293B;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="635" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_body" value="&lt;div style=&quot;line-height: 1.6;&quot;&gt;&lt;b style=&quot;color: #B7791F;&quot;&gt;*Atribut [PK]&lt;/b&gt; : Primary Key&lt;br&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**Atribut [FK]&lt;/b&gt; : Foreign Key (1:N)&lt;br&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;*Atribut [PK, FK]&lt;/b&gt; : Composite Key (M:N)&lt;br&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;[FK, UK]&lt;/b&gt; : Foreign Key Unik (Relasi 1:1)&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #CBD5E1; margin: 6px 0;&quot;&gt;&lt;b style=&quot;color: #215865;&quot;&gt;Derajat Kardinalitas:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;1 : N&lt;/b&gt; (One to Many, Panah menuju FK)&lt;br&gt;• &lt;b&gt;1 : 1&lt;/b&gt; (One to One, Unique FK Constraint)&lt;br&gt;• &lt;b&gt;M : N&lt;/b&gt; (Dipecha via Junction rapat_biro)&lt;br&gt;• &lt;b&gt;Unary&lt;/b&gt; (Relasi mandiri ke tabel asal)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.2;fontColor=#334155;fontStyle=0;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="667" width="280" height="165" as="geometry" />
        </mxCell>

        <!-- ================= EDGES / GARIS RELASI (ORTHOGONAL) ================= -->

        <!-- 9. rapat -> notulen_rapat (1:1) -->
        <mxCell id="edge_mtg_not" value="1 : 1 (UK)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#215865;strokeWidth=1.8;fontSize=11;fontColor=#215865;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mtg_hdr" target="not_hdr">

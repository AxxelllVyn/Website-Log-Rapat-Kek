          <mxGeometry x="680" y="770" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="notif_body" value="&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #B7791F;&quot;&gt;*id_notifikasi : VARCHAR(50) [PK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_pengguna : VARCHAR(50) [FK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;judul : VARCHAR(255)&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;pesan : TEXT&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;tipe : VARCHAR(50)&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;tautan : VARCHAR(500)&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;sudah_dibaca : BOOLEAN&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;dibuat_pada : TIMESTAMP&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94A3B8;strokeWidth=1.2;fontColor=#1E293B;fontStyle=0;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="802" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- ================= KOLOM 4: TINDAK LANJUT & LEGENDA (x=1000..1280) ================= -->
        <!-- 13. tindak_lanjut -->
        <mxCell id="act_hdr" value="tindak_lanjut" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#215865;strokeColor=#183E47;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act_body" value="&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #B7791F;&quot;&gt;*id_tindak_lanjut : VARCHAR(50) [PK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_rapat : VARCHAR(50) [FK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_biro : VARCHAR(50) [FK]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_tim : VARCHAR(50) [FK, Null]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;**id_pengguna : VARCHAR(50) [FK, Null]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;judul_tindakan : VARCHAR(255)&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;deskripsi_tindakan : TEXT&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;tenggat_waktu : TIMESTAMP&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;status_tindak_lanjut : ENUM&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;skala_prioritas : ENUM&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;diselesaikan_pada : TIMESTAMP&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;dibuat_pada : TIMESTAMP&lt;/div&gt;&lt;div style=&quot;line-height: 1.5; color: #334155;&quot;&gt;diperbarui_pada : TIMESTAMP&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94A3B8;strokeWidth=1.2;fontColor=#1E293B;fontStyle=0;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="122" width="280" height="235" as="geometry" />

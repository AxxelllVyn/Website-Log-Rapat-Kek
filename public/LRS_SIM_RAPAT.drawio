        <!-- 16. rapat -> rapat_biro (1:N via junction) -->
        <mxCell id="edge_mtg_rb" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B45309;strokeWidth=1.8;fontSize=11;fontColor=#B45309;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mtg_body" target="rb_hdr">

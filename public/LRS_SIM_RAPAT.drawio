        <mxCell id="edge_act_acthist" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#215865;strokeWidth=1.8;fontSize=11;fontColor=#215865;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="act_body" target="acthist_hdr">
